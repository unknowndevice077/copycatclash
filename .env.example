# ---- Server ----
NODE_ENV=development
PORT=3001
# Comma-separated list of allowed browser origins (dev: Vite on 5173).
CORS_ORIGIN=http://localhost:5173
# REQUIRED in production. Long random string used to sign session tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Set to true behind a reverse proxy / load balancer (Render, Fly, Nginx) so client IPs are correct.
TRUST_PROXY=false
# Cookies are Secure automatically in production; force here if needed.
COOKIE_SECURE=false

# ---- AI judge (Anthropic) ----
# Without a key every round is scored by the local pixel judge (marked "estimated").
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
AI_TIMEOUT_MS=6000
AI_MAX_CONCURRENCY=4
AI_MAX_CALLS_PER_MIN=60
AI_MAX_CALLS_PER_MATCH=40
AI_FAILURES_BEFORE_DEGRADED=3
AI_DEGRADED_COOLDOWN_MS=60000
# Simulate an AI outage (playtesting the fallback). Also toggleable at POST /api/dev/ai-failure in dev.
SCORING_SIMULATE_AI_FAILURE=false
# Break sub-2-point draws with the pixel score instead of awarding +1 to both teams.
SCORING_TIE_BREAK_BY_PIXELS=false

# ---- Photos ----
# local = curated library in ./photos (default). unsplash = live random photos (needs key).
PHOTO_PROVIDER=local
UNSPLASH_ACCESS_KEY=
UNSPLASH_APP_NAME=copy_cat_clash

# ---- Storage ----
DATA_DIR=./data
PHOTOS_DIR=./photos
# DATABASE_PATH=./data/copycatclash.sqlite
CLIENT_DIST=../client/dist

# ---- Scaling / limits ----
# Set to share queues across instances and enable the Socket.IO Redis adapter.
REDIS_URL=
MAX_CONN_PER_IP=12
MAX_TOTAL_CONNECTIONS=5000
LOG_LEVEL=info

# ---- In-game bug reports (see README, "Bug reports") ----
# GitHub: a private repo plus a fine-grained token with Issues: read and write on it.
BUG_REPORT_GITHUB_REPO=
BUG_REPORT_GITHUB_TOKEN=
# Discord: a channel webhook URL.
BUG_REPORT_DISCORD_WEBHOOK=
